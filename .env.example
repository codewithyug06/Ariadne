# Ariadne configuration — copy to .env and fill in every REQUIRED value.
# No secrets are committed here; every placeholder must be replaced before
# running in production.
#
# Quick-start for a new deployment:
#   1. Set ARIADNE_DOMAIN and DASHBOARD_DOMAIN to real DNS names.
#   2. Generate secrets for JWT_SECRET_KEY and ARIADNE_API_KEYS (commands below).
#   3. Set ARIADNE_ADMIN_EMAIL / ARIADNE_ADMIN_PASSWORD (first-boot bootstrap).
#   4. Set UPSTREAM_MCP_URL to your own tool server.
#   5. docker compose -f docker-compose.prod.yml --env-file .env up --build -d
#
# Global MCP endpoint (where agents connect after sign-up):
#   https://<ARIADNE_DOMAIN>/mcp
#   Authenticate with header:  X-Api-Key: <org-api-key>
#   Agents set:                UPSTREAM_MCP_URL=https://<ARIADNE_DOMAIN>/mcp
#
# Dashboard for human operators:
#   Sign in:  https://<DASHBOARD_DOMAIN>/login
#   Sign up:  https://<DASHBOARD_DOMAIN>/signup  (self-serve org creation)

# ---- Server -----------------------------------------------------------------
ARIADNE_HOST=0.0.0.0
ARIADNE_PORT=8000
LOG_LEVEL=INFO
# Comma-separated or a JSON array. If the dashboard is deployed separately
# from Ariadne (e.g. dashboard on Vercel, Ariadne on Fly.io/Railway/a VPS),
# this MUST include that dashboard's real origin, e.g.
# CORS_ORIGINS=https://app.yourcompany.vercel.app
CORS_ORIGINS=http://localhost:5173
# development | production. production refuses to start with an empty
# ARIADNE_API_KEYS — see docker-compose.prod.yml.
ARIADNE_ENV=development
# Comma-separated bearer tokens required on every route except /health and
# /metrics. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty in development to run unauthenticated.
ARIADNE_API_KEYS=
# Requests per minute, per API key (or per client IP if unauthenticated).
RATE_LIMIT_PER_MINUTE=120

# ---- Dashboard user login (separate from ARIADNE_API_KEYS above, which is
# for machine callers) -------------------------------------------------------
# Signs dashboard JWTs. production refuses to start without one. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never reuse the placeholder below — it is not a real key.
JWT_SECRET_KEY=CHANGE_ME_generate_a_real_key_see_command_above
# Bootstraps exactly one admin account the first time the users table is
# empty. Ignored on every later boot — change the password from the
# dashboard after first login, not by editing these.
ARIADNE_ADMIN_EMAIL=admin@yourcompany.example
ARIADNE_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password

# ---- Google OAuth2 (optional — enables "Continue with Google" on login/signup) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URI: https://<DASHBOARD_DOMAIN>/api/v1/auth/google/callback
#   (for local dev: http://localhost:5173/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base URL of the dashboard as seen by end-users' browsers. Used to construct
# the OAuth2 redirect_uri and the post-auth redirect. Must NOT have a trailing
# slash. In production set to https://<DASHBOARD_DOMAIN>.
DASHBOARD_PUBLIC_URL=http://localhost:5173

# ---- Billing ----------------------------------------------------------------
# A hosted Razorpay Payment Page link (public, not a secret). Served as-is by
# GET /api/v1/billing/upgrade. No Razorpay API key or webhook secret is
# configured yet, so a completed payment does not automatically change an
# org's plan -- see ariadne/api/billing.py's module docstring.
RAZORPAY_PAYMENT_LINK=https://rzp.io/rzp/ariadne

# ---- Connect your agent (ariadne/api/connect.py) -----------------------------
# Encrypts each org's own upstream tool-server auth headers at rest. Required
# before PUT /api/v1/connect/upstream will accept any headers -- unset means
# that endpoint refuses to store them rather than saving them unencrypted.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
UPSTREAM_ENCRYPTION_KEY=

# ---- TLS + public domains (docker-compose.prod.yml's `proxy` / Caddy) -------
# Public DNS names that resolve to this host. Caddy auto-provisions Let's
# Encrypt certificates — no manual cert management needed.
# Both must resolve to this host and ports 80/443 must be reachable from the
# internet for the ACME HTTP-01 challenge before the proxy service starts.
#
# ARIADNE_DOMAIN=ariadne.yourcompany.com       # API + global /mcp endpoint
# DASHBOARD_DOMAIN=app.yourcompany.com         # sign-in, sign-up, dashboard
#
# ARIADNE_PUBLIC_URL is what the dashboard shows users as the address to point
# their agent orchestrator at (e.g. in Settings → "Connect your agent").
# ARIADNE_PUBLIC_URL=https://ariadne.yourcompany.com

# ---- Upstream MCP server Ariadne proxies to ---------------------------------
UPSTREAM_MCP_URL=http://localhost:9000/mcp
UPSTREAM_TIMEOUT_SECONDS=30
# FAIL_CLOSED (default): an internal Ariadne error blocks the tool call.
# FAIL_OPEN: an internal error forwards the call unscored.
FAIL_MODE=FAIL_CLOSED

# ---- Persistence ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/ariadne.db
# Leave ARCADEDB_URL unset to use the in-process NetworkX graph store.
# ARCADEDB_URL=http://localhost:2480
# ARCADEDB_USER=root
# ARCADEDB_PASSWORD=change_me
# ARCADEDB_DATABASE=ariadne

# ---- Embedding (GPU: RTX 4050 Laptop, 6 GB VRAM) ----------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# cuda | cpu | auto — falls back to cpu automatically when CUDA is unavailable.
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# ---- Drift trajectory scoring ------------------------------------------------
DRIFT_WINDOW_SIZE=5
DRIFT_SLOPE_THRESHOLD=0.04
DRIFT_SCORE_WARN=40
DRIFT_SCORE_ESCALATE=66.5
DRIFT_SCORE_BLOCK=86.5

# ---- Intent decomposition (local LLM, optional) -----------------------------
# On Windows/low-disk hosts, point Ollama's model store at a drive with room
# before pulling: `OLLAMA_MODELS=D:\OllamaModels ollama serve` (mistral:7b
# is ~4.1 GB). Without OLLAMA_URL reachable, Ariadne falls back to the
# heuristic decomposer automatically — this is the tested default path.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=30
DECOMPOSER_MAX_RETRIES=3

# ---- Enforcement ------------------------------------------------------------
# Leave OPA_URL unset to use the built-in Python policy engine.
# OPA_URL=http://localhost:8181
OPA_POLICY_PATH=/v1/data/ariadne/allow
# Where ESCALATE decisions are POSTed for human approval.
# HITL_WEBHOOK_URL=http://localhost:7000/ariadne/hitl
HITL_TIMEOUT_SECONDS=60
MAX_TOOL_CALLS_PER_SESSION=200
# Tools that are never callable through this proxy, comma-separated.
DISALLOWED_TOOLS=
